# OpenAI — required for LLM training/inference (not needed for local-heuristic demo).
# All three are required when using gpt-* models: the client is constructed with
# api_key + organization + project.
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG=org-your-org-id
OPENAI_PROJECT=proj_your-project-id

# Prefer a cheap nano-class model. If this id is unavailable the workbench
# falls back through OPENAI_FALLBACK_MODEL then other small models.
OPENAI_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# MLflow Tracking Server (same instance is used for experiments, registry, and traces)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_UI_URL=http://127.0.0.1:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///./mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Default registered model name used when promoting a run
MLFLOW_REGISTERED_MODEL_NAME=sentiment-classifier

# Optional: experiment used only for production inference traces (not training)
MLFLOW_PROD_TRACE_EXPERIMENT=workbench-production-traces

# Workbench web app
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000
